# ---------------------------------------------------------------------------
# Supabase → Project Settings → API
# ---------------------------------------------------------------------------

# Estas dos van al navegador (prefijo NEXT_PUBLIC_). Es correcto y seguro:
# la clave publishable está pensada para ser pública.
#
# Coge la marcada como public / publishable ("sb_publishable_..." o el JWT
# legacy "eyJ..."), NUNCA la service_role / secret: esa se salta RLS y aquí
# acabaría dentro del bundle del navegador. El código lo comprueba y se niega
# a arrancar si te equivocas.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# ---------------------------------------------------------------------------
# Google AI Studio → Get API key (https://aistudio.google.com)
# ---------------------------------------------------------------------------

# Lectura de la hoja de personaje con visión. Solo servidor: SIN prefijo
# NEXT_PUBLIC_, o la key acabaría en el bundle del navegador.
GEMINI_API_KEY=AIzaSyBRRCApueDftsuC-J5wN4XAy73LrfN9sIA

# Cambiar de modelo es cambiar esta línea (p. ej. gemini-3.7-flash).
GEMINI_MODEL="gemini-3.8-flash"
